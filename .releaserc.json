{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "type": "perf", "release": "patch" },
          { "type": "refactor", "release": "patch" },
          { "type": "build", "release": "patch" }
        ]
      }
    ],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/exec", { "prepareCmd": "python3 scripts/set_version.py ${nextRelease.version}" }],
    [
      "@semantic-release/git",
      {
        "assets": ["custom_components/livoltek_local/manifest.json", "pyproject.toml"],
        "message": "chore: release ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    ["@semantic-release/github", { "successComment": false, "failComment": false, "releasedLabels": false }]
  ]
}
